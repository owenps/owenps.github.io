{
  "name": "owenps-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "hugo --minify",
    "dev": "hugo --buildDrafts && wrangler pages dev public",
    "dev:content": "hugo --buildDrafts --watch",
    "db:migrate:local": "wrangler d1 migrations apply GUESTBOOK_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply GUESTBOOK_DB --remote"
  },
  "devDependencies": {
    "wrangler": "^4.154.0"
  }
}
